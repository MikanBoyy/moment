plotshape(finalBullishSignal, title = "Bullish RSI divergence", style = shape.triangleup, location = location.belowbar, color = color.new(#00C853, 0), size = size.small, text = "BUY")
plotshape(finalBearishSignal, title = "Bearish RSI divergence", style = shape.triangledown, location = location.abovebar, color = color.new(#E53935, 0), size = size.small, text = "SELL")
plotshape(enableExitSignals and exitBullishSignal, title = "Exit bullish signal", style = shape.xcross, location = location.abovebar, color = color.new(#D84315, 0), size = size.small, text = "EXIT BUY")
plotshape(enableExitSignals and exitBearishSignal, title = "Exit bearish signal", style = shape.xcross, location = location.belowbar, color = color.new(#1565C0, 0), size = size.small, text = "EXIT SELL")
plotshape(profitBullishSignal, title = "Take profit bullish", style = shape.diamond, location = location.abovebar, color = color.new(#00897B, 0), size = size.small, text = "TP BUY")
plotshape(profitBearishSignal, title = "Take profit bearish", style = shape.diamond, location = location.belowbar, color = color.new(#00897B, 0), size = size.small, text = "TP SELL")
plotshape(reverseBullishSignal, title = "Opposite signal exit bullish", style = shape.xcross, location = location.abovebar, color = color.new(#FF9800, 0), size = size.small, text = "REV BUY")
plotshape(reverseBearishSignal, title = "Opposite signal exit bearish", style = shape.xcross, location = location.belowbar, color = color.new(#FF9800, 0), size = size.small, text = "REV SELL")
plot(enableExitSignals and signalPosition.direction != ZONE_ROLE_NEUTRAL ? signalPosition.stopLevel : na, title = "Exit threshold", color = color.new(#D84315, 25), style = plot.style_linebr)
plot(signalPosition.direction != ZONE_ROLE_NEUTRAL ? signalPosition.profitTarget : na, title = "Profit target", color = color.new(#00897B, 25), style = plot.style_linebr)

alertcondition(finalBullishSignal and requireZoneMatch, title = "Zone bullish divergence", message = "RSI強気ダイバージェンスと事前形成ゾーンの一致: {{ticker}}")
alertcondition(finalBearishSignal and requireZoneMatch, title = "Zone bearish divergence", message = "RSI弱気ダイバージェンスと事前形成ゾーンの一致: {{ticker}}")
alertcondition(finalBullishSignal and not requireZoneMatch, title = "RSI bullish divergence", message = "RSI強気ダイバージェンス: {{ticker}}")
alertcondition(finalBearishSignal and not requireZoneMatch, title = "RSI bearish divergence", message = "RSI弱気ダイバージェンス: {{ticker}}")
alertcondition(enableExitSignals and exitBullishSignal, title = "Exit bullish divergence", message = "BUYシグナルの撤退候補: {{ticker}}")
alertcondition(enableExitSignals and exitBearishSignal, title = "Exit bearish divergence", message = "SELLシグナルの撤退候補: {{ticker}}")
alertcondition(profitBullishSignal, title = "Take profit bullish divergence", message = "BUYシグナルの利確候補: {{ticker}}")
alertcondition(profitBearishSignal, title = "Take profit bearish divergence", message = "SELLシグナルの利確候補: {{ticker}}")
alertcondition(reverseBullishSignal, title = "Opposite signal exit bullish", message = "反対サインによるBUY決済候補: {{ticker}}")
alertcondition(reverseBearishSignal, title = "Opposite signal exit bearish", message = "反対サインによるSELL決済候補: {{ticker}}")