plotshape(showStructureSignals and filteredStructureBuySignal, title = "Market structure buy", style = shape.triangleup, location = location.belowbar, color = color.new(#00897B, 0), size = size.small, text = "構造 BUY")
plotshape(showStructureSignals and filteredStructureSellSignal, title = "Market structure sell", style = shape.triangledown, location = location.abovebar, color = color.new(#D84315, 0), size = size.small, text = "構造 SELL")
plotshape(showStructureSignals and structureExitBuy, title = "Market structure exit buy", style = shape.xcross, location = location.abovebar, color = color.new(#D84315, 0), size = size.small, text = "構造 EXIT BUY")
plotshape(showStructureSignals and structureExitSell, title = "Market structure exit sell", style = shape.xcross, location = location.belowbar, color = color.new(#1565C0, 0), size = size.small, text = "構造 EXIT SELL")
plotshape(showStructureSignals and structureProfitBuy, title = "Market structure take profit buy", style = shape.diamond, location = location.abovebar, color = color.new(#00897B, 0), size = size.small, text = "構造 TP BUY")
plotshape(showStructureSignals and structureProfitSell, title = "Market structure take profit sell", style = shape.diamond, location = location.belowbar, color = color.new(#00897B, 0), size = size.small, text = "構造 TP SELL")
plot(showStructureSignals and structurePosition.direction != 0 ? structurePosition.opposingZonePrice : na, title = "Market structure opposing zone reference", color = color.new(#00897B, 25), style = plot.style_linebr)

alertcondition(filteredStructureBuySignal, title = "Market structure buy", message = "市場構造の反転 BUY: {{ticker}}")
alertcondition(filteredStructureSellSignal, title = "Market structure sell", message = "市場構造の反転 SELL: {{ticker}}")
alertcondition(structureExitBuy, title = "Market structure exit buy", message = "市場構造 BUY の撤退候補: {{ticker}}")
alertcondition(structureExitSell, title = "Market structure exit sell", message = "市場構造 SELL の撤退候補: {{ticker}}")
alertcondition(structureProfitBuy, title = "Market structure take profit buy", message = "市場構造 BUY の利確候補: {{ticker}}")
alertcondition(structureProfitSell, title = "Market structure take profit sell", message = "市場構造 SELL の利確候補: {{ticker}}")