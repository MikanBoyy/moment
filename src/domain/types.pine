type PivotEvidence
    float price
    int pivotTime
    int timeframeId
    int side
    float sourceAtr
    float volumeRatio

type LiquidityZone
    float topPrice
    float bottomPrice
    float centerPrice
    int role
    int state
    int createdTime
    int invalidatedTime
    int evidenceCount
    int timeframeMask
    float score
    int lastEvidenceTime

type SignalZoneCandidate
    int pivotBar
    int direction
    float pivotPrice
    float topPrice
    float bottomPrice
    int role
    float score
    int timeframeMask
    float atr

type SignalPositionState
    int direction
    float stopLevel
    float profitTarget
    int consecutiveBreaks
    float entryPrice

type StructurePositionState
    int direction
    float profitTarget

type StructureZoneCandidate
    int pivotBar
    int direction
    float pivotPrice
    float topPrice
    float bottomPrice
    float atr
    float score
    float breakoutPrice

type MarketStructureState
    int direction
    int blockedDirection
    int endedDirection
    bool warning
    StructureZoneCandidate protectedZone
    StructureZoneCandidate pendingZone
    bool pendingBreakout