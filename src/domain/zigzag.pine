// atrPeriod と pivotStrength を使い、現在足で確認された高値・安値ピボットを抽出する。
// 戻り値: [確定有無、価格、時刻、種別、現在足のATR、ピボット足の出来高比率]。
f_extract_confirmed_pivot(atrPeriod, pivotStrength) =>
    float atrValue = ta.atr(atrPeriod)
    float volumeAverage = ta.sma(volume, 20)
    float pivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)
    float pivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)
    bool isHighPivot = not na(pivotHigh)
    bool isLowPivot = not na(pivotLow)
    bool pivotConfirmed = isHighPivot or isLowPivot
    float confirmedPrice = isHighPivot ? pivotHigh : pivotLow
    int confirmedTime = pivotConfirmed ? time[pivotStrength] : na
    int confirmedSide = isHighPivot ? PIVOT_SIDE_HIGH : isLowPivot ? PIVOT_SIDE_LOW : PIVOT_SIDE_NONE
    float volumeRatio = pivotConfirmed and not na(volumeAverage[pivotStrength]) and volumeAverage[pivotStrength] > 0 ? volume[pivotStrength] / volumeAverage[pivotStrength] : na
    [pivotConfirmed, confirmedPrice, confirmedTime, confirmedSide, atrValue, volumeRatio]