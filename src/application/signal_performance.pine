
var float simulatedEntryPrice = na
var float simulatedGrossProfit = 0.0
var float simulatedGrossLoss = 0.0
var int simulatedClosedCount = 0
var int simulatedWinCount = 0
if finalBullishSignal or finalBearishSignal
    simulatedEntryPrice := close
if exitBullishSignal or profitBullishSignal or reverseBullishSignal or exitBearishSignal or profitBearishSignal or reverseBearishSignal
    bool closedBullish = exitBullishSignal or profitBullishSignal or reverseBullishSignal
    if not na(simulatedEntryPrice)
        float simulatedResult = closedBullish ? close - simulatedEntryPrice : simulatedEntryPrice - close
        simulatedGrossProfit := simulatedGrossProfit + math.max(simulatedResult, 0.0)
        simulatedGrossLoss := simulatedGrossLoss + math.max(-simulatedResult, 0.0)
        simulatedClosedCount := simulatedClosedCount + 1
        simulatedWinCount := simulatedWinCount + (simulatedResult > 0 ? 1 : 0)
    simulatedEntryPrice := na