
var float simulatedEntryPrice = na
var float simulatedGrossProfit = 0.0
var float simulatedGrossLoss = 0.0
var int simulatedClosedCount = 0
var int simulatedWinCount = 0
if finalBullishSignal or finalBearishSignal
    simulatedEntryPrice := close
if exitBullishSignal or profitBullishSignal or reverseBullishSignal or exitBearishSignal or profitBearishSignal or reverseBearishSignal
    bool closedBullish = exitBullishSignal or profitBullishSignal or reverseBullishSignal
    if not na(simulatedEntryPrice)
        [grossProfit, grossLoss, winCount] = f_closed_trade_performance(simulatedEntryPrice, close, closedBullish)
        simulatedGrossProfit := simulatedGrossProfit + grossProfit
        simulatedGrossLoss := simulatedGrossLoss + grossLoss
        simulatedClosedCount := simulatedClosedCount + 1
        simulatedWinCount := simulatedWinCount + winCount
    simulatedEntryPrice := na

var float structureSimulatedEntryPrice = na
var float structureSimulatedGrossProfit = 0.0
var float structureSimulatedGrossLoss = 0.0
var int structureSimulatedClosedCount = 0
var int structureSimulatedWinCount = 0
if barstate.isconfirmed and previousStructurePositionDirection == 0 and structurePosition.direction != 0
    structureSimulatedEntryPrice := close
if structureExitBuy or structureProfitBuy or structureExitSell or structureProfitSell
    bool closedBuy = structureExitBuy or structureProfitBuy
    if not na(structureSimulatedEntryPrice)
        [grossProfit, grossLoss, winCount] = f_closed_trade_performance(structureSimulatedEntryPrice, close, closedBuy)
        structureSimulatedGrossProfit := structureSimulatedGrossProfit + grossProfit
        structureSimulatedGrossLoss := structureSimulatedGrossLoss + grossLoss
        structureSimulatedClosedCount := structureSimulatedClosedCount + 1
        structureSimulatedWinCount := structureSimulatedWinCount + winCount
    structureSimulatedEntryPrice := na