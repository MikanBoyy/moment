// 確定足でRSIシグナルの新規・終了・追加を判定し、state を更新する。
// bullishSignal/bearishSignal は元シグナル、allow 系は新規入口だけの許可、各 Zone は損切り基準。
// zones と activeZoneMaxAgeHours は利確目標、enable 系は終了・追加、bufferAtr と confirmationBars は損切り設定。
// 戻り値: 強気・弱気の順に、新規、損切り、利確、反対シグナル終了、ナンピン、ピラミッディングの各フラグ。
f_update_signal_position(
    SignalPositionState state, bool bullishSignal, bool bearishSignal, bool allowBullishEntry, bool allowBearishEntry,
    SignalZoneCandidate bullishZone, SignalZoneCandidate bearishZone, zones, bool enableExitSignals, bool enableAddSignals,
    float bufferAtr, int confirmationBars, int activeZoneMaxAgeHours) =>
    bool enterBullish = false
    bool enterBearish = false
    bool exitBullish = false
    bool exitBearish = false
    bool profitBullish = false
    bool profitBearish = false
    bool reverseBullish = false
    bool reverseBearish = false
    bool averageDownBullish = false
    bool averageDownBearish = false
    bool pyramidBullish = false
    bool pyramidBearish = false
    if barstate.isconfirmed
        int previousDirection = state.direction
        if previousDirection != ZONE_ROLE_NEUTRAL
            bool breached = enableExitSignals and not na(state.stopLevel) and (previousDirection == ZONE_ROLE_SUPPORT ? close < state.stopLevel : close > state.stopLevel)
            state.consecutiveBreaks := breached ? state.consecutiveBreaks + 1 : 0
            bool stopHit = breached and state.consecutiveBreaks >= confirmationBars
            bool profitHit = not na(state.profitTarget) and (previousDirection == ZONE_ROLE_SUPPORT ? high >= state.profitTarget : low <= state.profitTarget)
            bool oppositeSignal = previousDirection == ZONE_ROLE_SUPPORT ? bearishSignal : bullishSignal
            if stopHit or profitHit or oppositeSignal
                exitBullish := stopHit and previousDirection == ZONE_ROLE_SUPPORT
                exitBearish := stopHit and previousDirection == ZONE_ROLE_RESISTANCE
                profitBullish := not stopHit and profitHit and previousDirection == ZONE_ROLE_SUPPORT
                profitBearish := not stopHit and profitHit and previousDirection == ZONE_ROLE_RESISTANCE
                reverseBullish := not stopHit and not profitHit and oppositeSignal and previousDirection == ZONE_ROLE_SUPPORT
                reverseBearish := not stopHit and not profitHit and oppositeSignal and previousDirection == ZONE_ROLE_RESISTANCE
                state.direction := ZONE_ROLE_NEUTRAL
                state.stopLevel := na
                state.profitTarget := na
                state.consecutiveBreaks := 0
                state.entryPrice := na
            else if enableAddSignals and not na(state.entryPrice)
                bool sameDirectionSignal = previousDirection == ZONE_ROLE_SUPPORT ? bullishSignal : bearishSignal
                bool favorable = previousDirection == ZONE_ROLE_SUPPORT ? close > state.entryPrice : close < state.entryPrice
                bool unfavorable = previousDirection == ZONE_ROLE_SUPPORT ? close < state.entryPrice : close > state.entryPrice
                averageDownBullish := sameDirectionSignal and unfavorable and previousDirection == ZONE_ROLE_SUPPORT
                averageDownBearish := sameDirectionSignal and unfavorable and previousDirection == ZONE_ROLE_RESISTANCE
                pyramidBullish := sameDirectionSignal and favorable and previousDirection == ZONE_ROLE_SUPPORT
                pyramidBearish := sameDirectionSignal and favorable and previousDirection == ZONE_ROLE_RESISTANCE
        else if bullishSignal != bearishSignal and (bullishSignal ? allowBullishEntry : allowBearishEntry)
            int direction = bullishSignal ? ZONE_ROLE_SUPPORT : ZONE_ROLE_RESISTANCE
            SignalZoneCandidate zone = bullishSignal ? bullishZone : bearishZone
            state.direction := direction
            state.stopLevel := na(zone) ? na : direction == ZONE_ROLE_SUPPORT ? math.min(zone.bottomPrice, zone.pivotPrice) - zone.atr * bufferAtr : math.max(zone.topPrice, zone.pivotPrice) + zone.atr * bufferAtr
            state.profitTarget := f_find_profit_target(zones, direction, close, time, activeZoneMaxAgeHours)
            state.consecutiveBreaks := 0
            state.entryPrice := close
            enterBullish := bullishSignal
            enterBearish := bearishSignal
    [enterBullish, enterBearish, exitBullish, exitBearish, profitBullish, profitBearish, reverseBullish, reverseBearish, averageDownBullish, averageDownBearish, pyramidBullish, pyramidBearish]