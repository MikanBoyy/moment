// 確定足で構造ポジション state の新規追跡と構造終了を処理する。
// structureDirection は終了判定、buySignal/sellSignal は入口、zones と activeZoneMaxAgeHours は対向境界の記録用。
// 戻り値: [買い損失終了、売り損失終了、買い利益終了、売り利益終了]。終了足では新規追跡しない。
f_update_structure_position(
    StructurePositionState state, int structureDirection, bool buySignal, bool sellSignal, zones,
    int activeZoneMaxAgeHours) =>
    bool exitBuy = false
    bool exitSell = false
    bool profitBuy = false
    bool profitSell = false
    if barstate.isconfirmed
        int previousDirection = state.direction
        if previousDirection != 0
            bool structureEnded = structureDirection != previousDirection
            if structureEnded
                bool profitable = not na(state.entryPrice) and (previousDirection == 1 ? close > state.entryPrice : close < state.entryPrice)
                exitBuy := not profitable and previousDirection == 1
                exitSell := not profitable and previousDirection == -1
                profitBuy := profitable and previousDirection == 1
                profitSell := profitable and previousDirection == -1
                state.direction := 0
                state.opposingZonePrice := na
                state.entryPrice := na
        else if buySignal != sellSignal
            state.direction := buySignal ? 1 : -1
            state.entryPrice := close
            int zoneDirection = buySignal ? ZONE_ROLE_SUPPORT : ZONE_ROLE_RESISTANCE
            state.opposingZonePrice := f_find_profit_target(zones, zoneDirection, close, time, activeZoneMaxAgeHours)
    [exitBuy, exitSell, profitBuy, profitSell]